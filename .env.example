# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side / Edge Functions only, never expose to client

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=photobooth-assets
R2_PUBLIC_URL=https://cdn.yourdomain.com   # custom CDN domain mapped to the bucket

# --- Local Print Daemon (used only by the daemon process, not the Next.js app) ---
DAEMON_MDNS_NAME=photobooth-print-server
DAEMON_HTTP_PORT=8080
DAEMON_STATIC_IP_FALLBACK=            # optional, filled in during venue setup if mDNS is blocked
PRINTER_DRIVER=cups                   # cups | windows-spooler

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
GALLERY_DEFAULT_EXPIRY_HOURS=72
